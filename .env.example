# Tempo environment. Copy to `.env` for local dev; in production set these in
# each host's dashboard (Vercel for web vars, Render for API vars). Never commit
# real secrets — `.env` and `.env.local` are gitignored.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV="development"            # "production" on Render/Vercel

# ── Database — PostgreSQL 16+ ────────────────────────────────────────────────
# Local: local Postgres. Production: Neon POOLED connection string
# (host contains "-pooler"), append ?sslmode=require.
DATABASE_URL="postgresql://chessreview:chessreview_dev@localhost:5432/chessreview"
# Only needed for `prisma migrate dev` locally (shadow DB). Not used in prod.
SHADOW_DATABASE_URL="postgresql://chessreview:chessreview_dev@localhost:5432/chessreview_shadow"

# ── Redis — OPTIONAL ─────────────────────────────────────────────────────────
# Unset → in-process job queue + in-memory cache (correct for a single
# instance, incl. the free Render tier). Set to an Upstash rediss:// URL only
# when running multiple API instances. ioredis auto-negotiates TLS for rediss://.
# REDIS_URL="rediss://default:<token>@<name>.upstash.io:6379"

# ── Clerk authentication (free plan) ─────────────────────────────────────────
# https://dashboard.clerk.com → API keys. Publishable key is public (web);
# secret key is server-only (API + Next middleware).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Dashboard → API keys → JWT public key (PEM). Enables networkless JWT
# verification in the API. If unset, the API falls back to fetching JWKS.
CLERK_JWT_KEY=""

# ── Service URLs ─────────────────────────────────────────────────────────────
# WEB (Vercel): points the browser at the API. Build-time inlined — redeploy
# web if it changes.
NEXT_PUBLIC_API_URL="http://localhost:3001"
# API (Render): allowed CORS origin(s). Comma-separate to also allow Vercel
# preview URLs, e.g. "https://tempo.vercel.app,https://tempo-git-dev.vercel.app".
WEB_URL="http://localhost:3000"
# Local-dev API port override; in prod the platform injects $PORT.
API_PORT="3001"

# ── External import APIs (keyless; Chess.com wants an identifying UA) ─────────
CHESSCOM_USER_AGENT="Tempo (contact: you@example.com)"
