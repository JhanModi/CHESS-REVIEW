# ── Database (PostgreSQL 16+) ────────────────────────────────────────────────
DATABASE_URL="postgresql://chessreview:chessreview_dev@localhost:5432/chessreview"
SHADOW_DATABASE_URL="postgresql://chessreview:chessreview_dev@localhost:5432/chessreview_shadow"

# ── Redis (OPTIONAL in dev) ──────────────────────────────────────────────────
# When unset, the API falls back to in-process queue + in-memory cache.
# Required in production (BullMQ workers, shared eval cache).
# REDIS_URL="redis://localhost:6379"

# ── Clerk authentication ─────────────────────────────────────────────────────
# https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Dashboard → API keys → JWT public key (PEM). Enables networkless JWT
# verification in the API. If unset, the API falls back to JWKS fetching.
CLERK_JWT_KEY=""

# ── Service URLs ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
API_PORT="3001"

# ── External import APIs (keyless, but Chess.com wants an identifying UA) ───
CHESSCOM_USER_AGENT="Tempo dev (contact: you@example.com)"
